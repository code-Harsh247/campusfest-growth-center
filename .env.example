# Copy to .env and set a long random password.
POSTGRES_PASSWORD=change-me

# The AI copilot. Leave empty to keep chat off; every screen works without it.
# Set a monthly spend limit on this key in the Claude Console.
ANTHROPIC_API_KEY=
# Optional: COPILOT_EFFORT=medium, COPILOT_PER_VISITOR_HOURLY=20, COPILOT_HOURLY_LIMIT=150
