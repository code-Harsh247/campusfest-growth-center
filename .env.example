# Copy to .env and set a long random password.
POSTGRES_PASSWORD=change-me

# The AI copilot. Leave both keys empty to keep chat off; every screen works without it.
# OpenRouter is used when its key is set (put a credit limit on the key there).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Default model: anthropic/claude-haiku-5.5 on OpenRouter, claude-haiku-5-5 on Anthropic.
# COPILOT_MODEL=anthropic/claude-sonnet-5.5
# COPILOT_EFFORT=medium   COPILOT_PER_VISITOR_HOURLY=20   COPILOT_HOURLY_LIMIT=150
